# OSRM engine data -- huge, regenerated from bangladesh-latest.osm.pbf via
# osrm-extract/osrm-partition/osrm-customize (see notebooks/training_pipeline.ipynb)
osrm-data/

# Raw + merged GPS trace downloads -- huge, re-downloadable from the OSM public trace API
gps-trace data/*.gpx
gps-trace data/raw_osm_download/
gps-trace data/raw_osm_download_wide/
gps-trace data/raw_osm_download_outskirts/

# Generated training-pipeline intermediates (rebuilt by the notebook)
gps-trace data/training_pipeline/

# Trained model artifacts -- large binaries, regenerated by the notebook
trained-model/*.joblib

# Generated prediction spreadsheets (keep the original route_legs.xlsx)
route_legs_with_predictions*.xlsx

# Jupyter
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Python
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db
